+                            args->data + 16 * sub_block_index,
+                            args->converted_data, i, j,
+                            args->width, args->height, z_pos_factor);
+                    }
+                    sub_block_index++;
+                }
+            }
+        }
+        cur_depth += block_depth;
+    }
+    return NULL;
