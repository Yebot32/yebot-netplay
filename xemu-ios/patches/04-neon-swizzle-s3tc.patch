+/*
+ * Parallel S3TC decompression constants.
+ * Used by both 2D (split by block rows) and 3D (split by z-blocks).
+ */
+#define S3TC_MIN_BLOCKS_FOR_MT  128  /* ~32x32 texture = 8x8 blocks */
+#define S3TC_MAX_THREADS        4
