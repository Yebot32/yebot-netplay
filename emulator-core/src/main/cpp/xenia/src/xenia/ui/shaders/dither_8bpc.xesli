#ifndef XENIA_UI_SHADERS_DITHER_8BPC_XESLI_
#define XENIA_UI_SHADERS_DITHER_8BPC_XESLI_

#include "xesl.xesli"

// The blue-noise values were historically expanded from the XeNoiseRow16 /
// XeBlueNoise16x16Values0Until256 macros in noise.xesli (still used by the
// GLSL/HLSL paths). slangc's preprocessor mis-tokenizes that invocation - a
// 34-line backslash-continued macro argument list - with "invalid suffix on
// integer literal" at the final row, so the Metal path consumes the same
// numbers pre-expanded, with identical float semantics:
//   value = v * (1.0f / 256.0f / 255.0f) + ((-0.5f + 0.5f / 256.0f) / 255.0f)

