#version 450
// Reduces a colour image to luma, with a box downsample folded in so one pass
// serves both levels of the pyramid: guest resolution to 1/4, then 1/4 to 1/16.
#include "frame_gen_common.h"

layout(local_size_x = XE_FG_LOCAL_SIZE, local_size_y = XE_FG_LOCAL_SIZE) in;
layout(set = 0, binding = 3, r32f) uniform writeonly image2D xe_fg_dst;

void main() {
  ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
  if (any(greaterThanEqual(vec2(coord), xe_fg.dst_size))) {
    return;
  }
  vec2 uv = (vec2(coord) + 0.5) / xe_fg.dst_size;
  if (xe_fg.flip != 0) {
    uv.y = 1.0 - uv.y;
  }

  float acc = 0.0;
  float n = 0.0;
  for (int y = 0; y < xe_fg.taps; ++y) {
    for (int x = 0; x < xe_fg.taps; ++x) {
      vec2 o = (vec2(float(x), float(y)) - float(xe_fg.taps - 1) * 0.5) *
               xe_fg.src_texel;
      acc += dot(texture(xe_fg_src0, uv + o).rgb, kLumaWeights);
      n += 1.0;
    }
  }
  imageStore(xe_fg_dst, coord, vec4(acc / n, 0.0, 0.0, 0.0));
}
