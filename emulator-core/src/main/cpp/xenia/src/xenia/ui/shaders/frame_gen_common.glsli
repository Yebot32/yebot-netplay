// Shared declarations for the frame generation compute passes.
//
// One descriptor set layout serves every pass: three combined image samplers
// and one storage image. A pass that needs fewer samplers has the spare
// bindings pointed at an image it already uses - writing every binding is
// cheaper than carrying four nearly identical layouts.
#define XE_FG_LOCAL_SIZE 8

layout(set = 0, binding = 0) uniform sampler2D xe_fg_src0;
layout(set = 0, binding = 1) uniform sampler2D xe_fg_src1;
layout(set = 0, binding = 2) uniform sampler2D xe_fg_src2;

layout(push_constant) uniform XeFgPush {
  vec2 src_texel;    // Texel size of the sampled inputs.
  vec2 dst_size;     // Destination size in texels, for the bounds check.
  vec2 px_per_texel; // Full-resolution pixels per input texel.
  float lambda;      // Smoothness penalty weight for the motion search.
  float t;           // Where between the two frames to land, 0..1.
  int taps;          // Box downsample width, luma pass.
  int mode;          // 0 = coarse three-step search, 1 = fine refinement.
  int steps;         // First step size of the coarse search.
  int use_pred;      // Whether src2 holds a usable prediction.
  int flip;          // Flip the sampled image vertically.
  // Where the disocclusion guard starts and finishes taking over. Lower pairs
  // bail out to the nearer frame sooner, which trades a little judder on a
  // moving edge for less of the transparent double image that makes generated
  // frames obvious.
  float fallback_lo;
  float fallback_hi;
} xe_fg;

const vec3 kLumaWeights = vec3(0.299, 0.587, 0.114);
